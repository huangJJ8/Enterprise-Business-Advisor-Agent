{
  "name": "enterprise-business-advisor-agent",
  "version": "0.1.0",
  "description": "ReAct agent backend (NestJS 11 + LangGraph) for enterprise business advisory",
  "author": "",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "npm run start:dev",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "cross-env PRODUCT_ENV=dev nest start",
    "start:dev": "cross-env PRODUCT_ENV=dev nest start --watch",
    "start:debug": "cross-env PRODUCT_ENV=dev nest start --debug --watch",
    "start:pre": "cross-env PRODUCT_ENV=pre node dist/main",
    "start:prod": "cross-env PRODUCT_ENV=prod node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@langchain/core": "^1.1.19",
    "@langchain/langgraph": "^1.1.3",
    "@langchain/openai": "^1.2.4",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@prisma/client": "^6.0.1",
    "@qdrant/js-client-rest": "^1.14.1",
    "@types/archiver": "^6.0.3",
    "@types/request-ip": "^0.0.41",
    "@types/tmp": "^0.2.6",
    "archiver": "^7.0.1",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "content-type": "^1.0.5",
    "cookie-parser": "^1.4.7",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "elliptic": "^6.6.1",
    "express-session": "^1.18.1",
    "html-to-docx": "^1.8.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.4.1",
    "iron-session": "^8.0.4",
    "langchain": "^1.2.17",
    "marked": "^4.3.0",
    "mime-types": "^3.0.2",
    "minimatch": "10.0.1",
    "mysql2": "^3.19.1",
    "nest-winston": "^1.9.7",
    "node-fetch": "^2.7.0",
    "nodemailer": "^6.10.0",
    "openai": "^4.87.3",
    "raw-body": "^3.0.1",
    "reflect-metadata": "^0.2.0",
    "request-ip": "^3.3.0",
    "rxjs": "^7.8.1",
    "strip-ansi": "^6.0.1",
    "svg-captcha": "^1.4.0",
    "tmp": "^0.2.5",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yaml": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.1",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/crypto-js": "^4.2.2",
    "@types/elliptic": "^6.4.18",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.2",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
