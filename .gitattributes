# 统一换行符：仓库内一律存 LF，避免 .sh 在 Linux/macOS/CI 上因 CRLF 无法执行
* text=auto

# 强制 LF（每种模式必须单独一行，gitattributes 不支持一行多模式）
*.sh            text eol=lf
*.bash          text eol=lf
*.ts            text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.sql           text eol=lf
*.svg           text eol=lf
.env.example    text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.dockerignore   text eol=lf
.npmrc          text eol=lf
Dockerfile      text eol=lf

# Windows 脚本保留 CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf

# 二进制文件不做换行转换
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.zip    binary
*.gz     binary
*.pdf    binary
*.mp4    binary
*.webm   binary
